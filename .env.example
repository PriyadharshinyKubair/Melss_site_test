# Postgres connection string for Payload CMS
DATABASE_URI=postgres://postgres:postgres@localhost:5432/melss

# Random secret used by Payload to sign tokens - generate your own for real use
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Absolute site URL, used to build canonical links and absolute og:url values
SITE_URL=http://localhost:3000